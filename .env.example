# 프론트엔드 환경변수
# 이 파일을 .env 로 복사한 뒤 배포 환경에 맞게 수정한다.
#   copy .env.example .env

# 백엔드 주소. 프로토콜과 포트는 제외하고 호스트만 적는다.
VITE_API_SERVER_HOST=localhost
VITE_API_SERVER_PORT=3001
VITE_API_PROTOCOL=http

# 같은 도메인에서 Nginx가 /api 를 프록시하면 아래처럼 둔다.
# VITE_API_SERVER_HOST=visualization.example.go.kr
# VITE_API_SERVER_PORT=80
# VITE_API_PROTOCOL=http

# 업로드 상한 10MB는 src/utils/dataParser.ts에 있다. 환경변수로 바꾸지 않는다.

# 카카오 로컬 REST API 키. 주소만 있는 지도 데이터를 위경도로 바꿀 때 사용한다.
# 데이터에 위도, 경도 열이 있으면 비워 둔다.
VITE_KAKAO_REST_API_KEY=

# 내부망 지도 타일 주소. {z} {x} {y} 자리표시자를 포함한다.
# 비우면 OpenStreetMap 타일을 사용하며, 이 경우 외부망이 필요하다.
# VITE_MAP_TILE_URL=https://tiles.example.go.kr/{z}/{x}/{y}.png
VITE_MAP_TILE_URL=

NODE_ENV=development
