{
  "name": "visualization-tracking-server",
  "version": "1.0.0",
  "description": "데이터 시각화 도구 트래킹 서버",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && prisma generate",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "node-fetch": "^3.3.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "prisma": "^5.7.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "braces": "file:../vendor/braces",
    "eslint": "^8.56.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "ajv": "6.14.0",
    "body-parser@1.20.3": "1.20.8",
    "brace-expansion@1.1.12": "1.1.21",
    "brace-expansion@2.0.2": "2.1.7",
    "braces": "$braces",
    "fast-copy": "3.1.0",
    "flatted": "3.4.2",
    "js-yaml@4.1.0": "4.3.2",
    "minimatch@3.1.2": "3.1.4",
    "minimatch@9.0.3": "9.0.7",
    "minimatch@9.0.5": "9.0.7",
    "path-to-regexp@0.1.12": "0.1.13",
    "picomatch@2.3.1": "2.3.2",
    "proxy-addr": "2.0.8",
    "qs@6.13.0": "6.16.1",
    "yaml": "2.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
