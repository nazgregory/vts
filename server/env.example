# 백엔드 환경변수
# 이 파일을 server/.env 로 복사한 뒤 값을 바꾼다.
#   copy env.example .env

# PostgreSQL 접속 문자열. 사용자, 비밀번호, DB 이름은 설치 환경에 맞게 변경한다.
DATABASE_URL="postgresql://viz_user:change_me@localhost:5432/visualization_tracking"

# IP 해시용 소금값. 임의 문자열로 바꾼다.
IP_SALT="change_me_to_secure_random_string"

# 브라우저에서 API 응답을 읽을 수 있는 출처. 쉼표로 구분한다.
ALLOWED_ORIGINS="http://localhost:3000"

PORT=3001
NODE_ENV="development"

BATCH_MAX=200
LOG_LEVEL="info"
